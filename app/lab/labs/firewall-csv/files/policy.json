[
  {
    "sid": "ReadConfig",
    "effect": "Allow",
    "actions": ["s3:GetObject", "s3:ListBucket"],
    "resources": ["arn:aws:s3:::nw-fw-config", "arn:aws:s3:::nw-fw-config/*"]
  },
  {
    "sid": "WriteLogs",
    "effect": "Allow",
    "actions": ["logs:CreateLogStream", "logs:PutLogEvents"],
    "resources": ["*"]
  },
  {
    "sid": "DenyConfigDelete",
    "effect": "Deny",
    "actions": ["s3:DeleteObject"],
    "resources": ["arn:aws:s3:::nw-fw-config/*"]
  }
]
